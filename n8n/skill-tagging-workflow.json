    {
      "parameters": {
        "jsCode": "const skills = ($json.skills || []).join(' ').toLowerCase();\n\nconst classification =\n  /n8n|zapier|make|langchain|openai|automation/.test(skills)\n    ? 'automation-heavy'\n    : /fastapi|django|react|javascript/.test(skills)\n      ? 'web-development'\n      : /python|sql|pandas|data/.test(skills)\n        ? 'data'\n        : 'general';\n\nreturn [{\n  json: {\n    person_id: $json.person_id,\n    name: $json.name,\n    skills: $json.skills,\n    classification,\n    classification_status: 'completed'\n  }\n}];"
      },
